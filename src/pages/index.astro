---
import FieldPhoto from "../components/FieldPhoto.astro";
import Site from "../layouts/Site.astro";
---
<Site title="Community Development in East Kalimantan" description="BESTARI is an independent social foundation in East Kalimantan supporting community-led learning, livelihoods, and sustainable development.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="place"><span aria-hidden="true"></span> From Belayan, East Kalimantan</p>
        <h1>Stronger communities.<br />Lasting possibilities.</h1>
        <p class="hero-description">We connect local knowledge with wider opportunity, so communities can shape a prosperous, sustainable future.</p>
        <div class="actions"><a class="button button-gold" href="/partner/">Partner with us <span aria-hidden="true">↗</span></a><a class="quiet-link" href="/work/">Explore our work</a></div>
        <p class="hero-signature">Belayan Sejahtera Lestari <span>Independent social foundation</span></p>
      </div>
      <FieldPhoto name="hero-belayan" alt="" hero caption="Our roots run along the Belayan River." />
    </div>
  </section>
  <section class="section container introduction">
    <p class="section-label">The belief behind BESTARI</p>
    <div><h2>Lasting change begins<br />with people.</h2><p>Farmers, women, young people, and local institutions hold the knowledge and ambition to move their communities forward. We work alongside them to turn that potential into opportunity.</p><a class="text-link" href="/about/">Get to know BESTARI <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="focus-section">
    <div class="container section">
      <div class="section-heading"><div><p class="section-label">Our focus</p><h2>Connected by purpose.</h2></div><p>Four areas of work.<br />One commitment to stronger communities.</p></div>
      <div class="focus-grid">
        <a href="/work/#education"><h3>Education &amp;<br />human development</h3><p>Practical knowledge. Greater possibilities.</p><span aria-hidden="true">↗</span></a>
        <a href="/work/#livelihoods"><h3>Community economy &amp;<br />sustainable livelihoods</h3><p>Local capacity. Economic independence.</p><span aria-hidden="true">↗</span></a>
        <a href="/work/#environment"><h3>Environment, climate &amp;<br />sustainable agriculture</h3><p>Resilient land. Resilient communities.</p><span aria-hidden="true">↗</span></a>
        <a href="/work/#knowledge"><h3>Research, knowledge &amp;<br />local culture</h3><p>Local experience. Shared understanding.</p><span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="container partnership-callout"><div><p class="section-label">A shared investment in the future</p><h2>Local roots.<br />Wider possibilities.</h2></div><div><p>Bring your knowledge, resources, and networks. Together, we can build opportunities that communities carry forward.</p><a class="button" href="/partner/">Let’s build a partnership <span aria-hidden="true">↗</span></a></div></section>
</Site>
