---
import { existsSync } from "node:fs";

interface Props {
  name: string;
  alt: string;
  caption?: string;
  hero?: boolean;
}
const { name, alt, caption, hero = false } = Astro.props;
const available = existsSync(`public/photos/${name}.jpg`);
---
<figure class:list={['field-photo', { 'hero-photo': hero }]}>
  {available ? <img src={`/photos/${name}.jpg`} alt={alt} width="1600" height="1200" loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} /> : <div class="river-art" aria-hidden="true"><img src="/river-study.svg" alt="" width="800" height="1000" /></div>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
